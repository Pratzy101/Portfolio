# Copy this file to .env and fill in real values.
# .env is gitignored — it never gets committed. This example file does.

# --- Database ---------------------------------------------------------
# SQLite by default. No setup, stores everything in portfolio.db.
DATABASE_URL=sqlite:///./portfolio.db
# Postgres example (only if you switch later):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- Email ------------------------------------------------------------
# Leave RESEND_API_KEY blank to run in console mode: submissions are saved
# and printed to your terminal instead of emailed. Good enough for local dev.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_TO=shaandilyaprathit@gmail.com

# --- App --------------------------------------------------------------
ENVIRONMENT=development
